generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  PARENT
}

enum Gender {
  MALE
  FEMALE
}

enum SectionType {
  ANGLOPHONE
  FRANCOPHONE
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISMISSED
  PENDING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ForumType {
  PARENT_FORUM
  STAFF_FORUM
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  RESULT_PUBLISHED
  ATTENDANCE_ALERT
  MARK_UPDATE
  ANNOUNCEMENT
  REPORT_AVAILABLE
  SYSTEM
}

enum AvailabilityStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum ForumCategoryScope {
  ALL
  STAFF
  PARENTS
}

enum AIMessageRole {
  USER
  ASSISTANT
}


// ============================================================
// USER
// ============================================================

model User {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  email        String        @unique
  passwordHash String?
  loginCode    String        @unique
  role         Role
  status       AccountStatus @default(ACTIVE)

  phone     String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications       Notification[]         @relation("NotificationRecipient")
  sentNotifications   Notification[]         @relation("NotificationSender")
  aiRecommendations   AIRecommendation[]
  forumMessages       ForumMessage[]
  aiConversations     AIConversation[]
  auditLogs           AuditLog[]
  publishedResults    ResultPublication[]
  publishedSequences  SequencePublication[]
  publishedTimetables TimetablePublication[]

  forumPosts     ForumPost[]     @relation("ForumPostAuthor")
  forumComments  ForumComment[]  @relation("ForumCommentAuthor")
  forumReactions ForumReaction[] @relation("ForumReactionUser")

  administrator Administrator?
  teacher       Teacher?
  parent        Parent?

  @@index([email])
  @@index([role])
  @@index([status])
}


// ============================================================
// ADMINISTRATOR
// ============================================================

model Administrator {
  id String @id @default(cuid())

  fullName String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}


// ============================================================
// TEACHER
// ============================================================

model Teacher {
  id String @id @default(cuid())

  firstName String
  lastName  String
  fullName  String

  email String
  phone String?

  gender String?

  dateOfBirth DateTime?

  userId    String @unique
  teacherId String @unique
  loginCode String @unique

  assignments  TeacherAssignment[]
  availability TeacherAvailability[]
  timetable    Timetable[]
  attendances  Attendance[]
  marks        Mark[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fullName])
  @@index([email])
}


// ============================================================
// PARENT
// ============================================================

model Parent {
  id String @id @default(cuid())

  userId   String @unique
  parentId String @unique

  fullName String
  lastName String
  email    String?
  phone    String?

  gender      String?
  dateOfBirth DateTime?
  image       String?

  children Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fullName])
  @@index([email])
}


// ============================================================
// SECTION
// ============================================================

model Section {
  id String @id @default(cuid())

  name SectionType @unique

  classrooms         Classroom[]
  teacherAssignments TeacherAssignment[]
}


// ============================================================
// ACADEMIC YEAR
// ============================================================

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime

  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms       Term[]
  timetables  Timetable[]
  reportCards ReportCard[]
  classrooms  Classroom[]
  students    Student[]

  @@index([isActive])
}


// ============================================================
// CLASSROOM
// ============================================================

model Classroom {
  id String @id @default(cuid())

  name String

  sectionId      String
  academicYearId String

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  assignments           TeacherAssignment[]
  classroomSubjects     ClassroomSubject[]
  timetable             Timetable[]
  reportCards           ReportCard[]
  students              Student[]
  resultPublications    ResultPublication[]
  sequencePublications  SequencePublication[]
  timetablePublications TimetablePublication[]

  @@unique([academicYearId, sectionId, name])
  @@index([sectionId])
  @@index([academicYearId])
  @@index([name])
}


// ============================================================
// STUDENT
// ============================================================

model Student {
  id String @id @default(cuid())

  matricule String @unique

  firstName String
  lastName  String

  gender      Gender
  dateOfBirth DateTime

  status AccountStatus @default(ACTIVE)

  // Identifies the academic year in which this student
  // is currently recorded/enrolled.
  academicYearId String

  // Identifies the classroom of the student.
  classroomId String

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  classroom Classroom @relation(fields: [classroomId], references: [id])

  attendances Attendance[]
  timetable   Timetable[]
  marks       Mark[]
  reportCards ReportCard[]

  parentId String?

  parent Parent? @relation(fields: [parentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academicYearId])
  @@index([classroomId])
  @@index([parentId])
  @@index([status])
  @@index([lastName, firstName])
}


// ============================================================
// SUBJECT
// ============================================================

model Subject {
  id String @id @default(cuid())

  name String
  code String @unique

  coefficient Int

  attendances Attendance[]
  marks       Mark[]

  assignments        TeacherAssignment[]
  timetables         Timetable[]
  reportCardSubjects ReportCardSubject[]
  classroomSubjects  ClassroomSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}


// ============================================================
// TEACHER ASSIGNMENT
// ============================================================

model TeacherAssignment {
  id String @id @default(cuid())

  teacherId   String
  sectionId   String
  classroomId String
  subjectId   String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teacherId, sectionId, classroomId, subjectId])
  @@index([classroomId])
  @@index([teacherId])
  @@index([subjectId])
}


// ============================================================
// TERM
// ============================================================

model Term {
  id String @id @default(cuid())

  name  String
  order Int

  isCurrent Boolean @default(false)

  academicYearId String

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  sequences             Sequence[]
  marks                 Mark[]
  reportCards           ReportCard[]
  timetables            Timetable[]
  resultPublications    ResultPublication[]
  timetablePublications TimetablePublication[]

  @@unique([academicYearId, order])
  @@index([academicYearId])
  @@index([isCurrent])
}


// ============================================================
// SEQUENCE
// ============================================================

model Sequence {
  id String @id @default(cuid())

  name  String
  order Int

  termId String

  term Term @relation(fields: [termId], references: [id], onDelete: Cascade)

  attendances Attendance[]
  marks       Mark[]

  sequencePublications SequencePublication[]

  createdAt DateTime @default(now())

  @@unique([termId, name])
  @@unique([termId, order])
  @@index([termId])
}


// ============================================================
// ATTENDANCE
// ============================================================

model Attendance {
  id String @id @default(cuid())

  studentId  String
  subjectId  String
  teacherId  String
  sequenceId String

  date DateTime

  status AttendanceStatus

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id])

  teacher Teacher @relation(fields: [teacherId], references: [id])

  sequence Sequence @relation(fields: [sequenceId], references: [id])

  createdAt DateTime @default(now())

  @@unique([studentId, subjectId, date])
  @@index([studentId])
  @@index([sequenceId])
  @@index([teacherId])
  @@index([date])
  @@index([status])
}


// ============================================================
// MARK
// ============================================================
//
// One Mark = one student's score for one subject
// in one term and one sequence.
//
// Example:
// Student A + Mathematics + First Term + First Sequence = 15
// Student A + Mathematics + First Term + Second Sequence = 17
//
// The term average is calculated from the sequence marks.
// ============================================================

model Mark {
  id String @id @default(cuid())

  studentId  String
  subjectId  String
  teacherId  String
  termId     String
  sequenceId String

  score Float

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id])

  teacher Teacher @relation(fields: [teacherId], references: [id])

  term Term @relation(fields: [termId], references: [id], onDelete: Cascade)

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, termId, sequenceId])
  @@index([studentId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([termId])
  @@index([sequenceId])
}

// ============================================================
// REPORT CARD
// ============================================================

model ReportCard {
  id String @id @default(cuid())

  studentId      String
  classroomId    String
  termId         String
  academicYearId String

  total   Float
  average Float

  position Int?

  decision String?

  principalRemark String?

  pdfUrl String?

  generatedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  classroom Classroom @relation(fields: [classroomId], references: [id])

  term Term @relation(fields: [termId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  subjects ReportCardSubject[]

  @@unique([studentId, termId])
}


// ============================================================
// REPORT CARD SUBJECT
// ============================================================

model ReportCardSubject {
  id String @id @default(cuid())

  reportCardId String
  subjectId    String

  // Final subject mark for the term.
  // Usually calculated from the sequence marks.
  mark Float

  grade  String?
  remark String?

  reportCard ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id])
}


// ============================================================
// RESULT PUBLICATION
// ============================================================

model ResultPublication {
  id String @id @default(cuid())

  termId      String
  classroomId String

  status PublicationStatus @default(DRAFT)

  publishedById String?
  publishedAt   DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  term Term @relation(fields: [termId], references: [id], onDelete: Cascade)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  publishedBy User? @relation(fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([termId, classroomId])
  @@index([termId])
  @@index([classroomId])
  @@index([status])
}


// ============================================================
// SEQUENCE PUBLICATION
// ============================================================

model SequencePublication {
  id String @id @default(cuid())

  sequenceId  String
  classroomId String

  status PublicationStatus @default(DRAFT)

  publishedById String?
  publishedAt   DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  publishedBy User? @relation(fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([sequenceId, classroomId])
  @@index([sequenceId])
  @@index([classroomId])
  @@index([status])
}


// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id String @id @default(cuid())

  title   String
  message String

  type NotificationType @default(INFO)

  isRead Boolean @default(false)

  userId String

  user User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  senderId String?

  sender User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  audience    String?
  actionUrl   String?
  relatedType String?
  relatedId   String?

  archivedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([type])
}


// ============================================================
// OLD-STYLE STAFF/PARENT FORUM
// ============================================================

model Forum {
  id String @id @default(cuid())

  title String

  type ForumType @unique

  messages ForumMessage[]
}

model ForumMessage {
  id String @id @default(cuid())

  message String

  forumId String
  userId  String

  forum Forum @relation(fields: [forumId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([forumId])
}


// ============================================================
// AI RECOMMENDATION
// ============================================================

model AIRecommendation {
  id String @id @default(cuid())

  title   String
  content String

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}


// ============================================================
// AI CONVERSATION
// ============================================================

model AIConversation {
  id String @id @default(cuid())

  title String

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages AIMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([updatedAt])
}


// ============================================================
// AI MESSAGE
// ============================================================

model AIMessage {
  id String @id @default(cuid())

  conversationId String

  role    AIMessageRole
  content String

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}


// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id String @id @default(cuid())

  actorId   String?
  actorName String?

  action     String
  entityType String
  entityId   String?

  description String

  metadata Json?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType])
  @@index([actorId])
  @@index([action])
}


// ============================================================
// FORUM CATEGORY
// ============================================================

model ForumCategory {
  id String @id @default(cuid())

  name String @unique
  slug String @unique

  description String?

  scope ForumCategoryScope @default(ALL)

  order Int @default(0)

  isLocked Boolean @default(false)

  posts ForumPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}


// ============================================================
// FORUM POST
// ============================================================

model ForumPost {
  id String @id @default(cuid())

  title String
  body  String

  categoryId String
  authorId   String

  isPinned  Boolean @default(false)
  isLocked  Boolean @default(false)
  isDeleted Boolean @default(false)

  views Int @default(0)

  category ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  author User @relation("ForumPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  comments  ForumComment[]
  reactions ForumReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([authorId])
  @@index([createdAt])
  @@index([isPinned])
}


// ============================================================
// FORUM COMMENT
// ============================================================

model ForumComment {
  id String @id @default(cuid())

  body String

  postId   String
  authorId String

  isDeleted Boolean @default(false)

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  author User @relation("ForumCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([authorId])
}


// ============================================================
// FORUM REACTION
// ============================================================

model ForumReaction {
  id String @id @default(cuid())

  postId String
  userId String

  type String

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  user User @relation("ForumReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// ============================================================
// TIMETABLE
// ============================================================

model Timetable {
  id String @id @default(cuid())

  classroomId String
  subjectId   String
  teacherId   String

  academicYearId String
  termId         String

  day       WeekDay
  startTime String
  endTime   String

  room String?

  classroom Classroom @relation(fields: [classroomId], references: [id])

  subject Subject @relation(fields: [subjectId], references: [id])

  teacher Teacher @relation(fields: [teacherId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  term Term @relation(fields: [termId], references: [id])

  studentId String?

  student Student? @relation(fields: [studentId], references: [id])

  @@index([classroomId, day])
  @@index([teacherId, day])
  @@index([termId])
}


// ============================================================
// TIMETABLE PUBLICATION
// ============================================================

model TimetablePublication {
  id String @id @default(cuid())

  termId      String
  classroomId String

  status PublicationStatus @default(DRAFT)

  publishedById String?
  publishedAt   DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  term Term @relation(fields: [termId], references: [id], onDelete: Cascade)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  publishedBy User? @relation(fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([termId, classroomId])
  @@index([termId])
  @@index([classroomId])
  @@index([status])
}


// ============================================================
// TEACHER AVAILABILITY
// ============================================================

model TeacherAvailability {
  id String @id @default(cuid())

  teacherId String

  day       WeekDay
  startTime String
  endTime   String

  status AvailabilityStatus @default(PENDING)
  note   String?

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([day])
  @@index([status])
}


// ============================================================
// CLASSROOM SUBJECT
// ============================================================

model ClassroomSubject {
  id String @id @default(cuid())

  classroomId String
  subjectId   String

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([classroomId, subjectId])
  @@index([classroomId])
  @@index([subjectId])
}
